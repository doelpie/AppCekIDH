rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health / Connection check path
    match /test/connection {
      allow read, write: if true;
    }

    // Master PCP collections (Synchronized across users)
    match /master_pcp/{docId} {
      allow read, write: if true;
    }

    // Master DEPO collections
    match /master_depo/{docId} {
      allow read, write: if true;
    }

    // Follow Up orders & WhatsApp tracking
    match /follow_up_orders/{docId} {
      allow read, write: if true;
    }
  }
}
